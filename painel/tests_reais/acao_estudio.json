{
  "_sobre": "Ação-fixture do estúdio: o --settings de referência das ações com sandbox (provas C3, C4, 2.3b, 4.2). Não é ação de uso.",
  "acoes": [
    {
      "id": "estudio.fixture",
      "grupo": "estudio",
      "titulo": "Ação-fixture do estúdio (provas do sandbox)",
      "descricao": "Não é ação de uso: é o --settings de referência das ações do estúdio (C3, C4, 2.3b, 4.2).",
      "risco": "rascunho",
      "sandbox": {"rede_local": true},
      "so_com": "estudio.video_rede_local",
      "env": {
        "HYPERFRAMES_NO_TELEMETRY": "1",
        "DO_NOT_TRACK": "1",
        "HYPERFRAMES_NO_UPDATE_CHECK": "1",
        "HYPERFRAMES_NO_AUTO_INSTALL": "1",
        "HYPERFRAMES_SKIP_SKILLS": "1",
        "HYPERFRAMES_HISTORY_ROOT": ".hyperframes_history",
        "GEMINI_API_KEY": "",
        "GOOGLE_API_KEY": ""
      },
      "negar": [
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "^(?!(?:ffmpeg|ffprobe|python3)(?: |\\Z)|/)",
          "motivo": "Bash do estúdio: só ffmpeg, ffprobe, python3 com script do estúdio ou o hyperframes fixado"
        },
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "\\.\\.|//|/\\./|--(?:describe|docker|ffmpeg|ffprobe|hyperframes)\\b",
          "motivo": "Bash do estúdio: sem '..', '//', snapshot --describe, render --docker nem caminho de ferramenta nos scripts"
        },
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "^(?=/)(?!(?!(?i:{trabalho}))(?!(?i:/proc/|/dev/|/System/Volumes/|[^ ]*/trabalhos/))(?:/[\\w.@+-]+)*/tune-up-studio(?:/[\\w.@+-]+)?/node/node_modules/\\.bin/hyperframes +(?:render|check|lint|validate|inspect|snapshot|info|compositions)(?: +(?:-[\\w.,:=+%@-]*|(?![/~=,-])(?:[\\w.+%@/]|[=,](?![/~]))+|(?i:{trabalho})(?:/[\\w.,+%@/-]*)?))* *\\Z)",
          "motivo": "hyperframes: só render, check, lint, validate, inspect, snapshot, info e compositions, saída em {trabalho}"
        },
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "^ffmpeg(?= |\\Z)(?!(?: +(?:-protocol_whitelist +file,pipe +-i +(?:(?![/~=,-])(?:[\\w.+%@/]|[=,](?![/~]))+|(?i:{trabalho})(?:/[\\w.,+%@/-]*)?)|(?!-i(?: |\\Z)|-protocol_whitelist(?: |\\Z))(?:-[\\w.,:=+%@-]*|(?![/~=,-])(?:[\\w.+%@/]|[=,](?![/~]))+|(?i:{trabalho})(?:/[\\w.,+%@/-]*)?)))* *\\Z)",
          "motivo": "ffmpeg: cada -i precedido de -protocol_whitelist file,pipe, sem ':' nem caminho fora de {trabalho}, grafo em arquivo"
        },
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "^ffprobe(?= |\\Z)(?!(?: +(?:-[\\w.,:=+%@-]*|(?![/~=,-])(?:[\\w.+%@/]|[=,](?![/~]))+|(?i:{trabalho})(?:/[\\w.,+%@/-]*)?))* *\\Z)",
          "motivo": "ffprobe: sem ':' nem caminho fora de {trabalho}"
        },
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "^python3(?= |\\Z)(?! +-I(?: +-B)? +(?!(?i:{trabalho}))(?!(?i:/proc/|/dev/|/System/Volumes/|[^ ]*/trabalhos/))(?:/[\\w.@+-]+)*/tune-up-studio(?:/[\\w.@+-]+)?/scripts/(?:qa_video|qa_imagem|reserva_slides|video_ou_reserva|fontes)\\.py(?: +(?:-[\\w.,:=+%@-]*|(?![/~=,-])(?:[\\w.+%@/]|[=,](?![/~]))+|(?i:{trabalho})(?:/[\\w.,+%@/-]*)?))* *\\Z)",
          "motivo": "python3: só os scripts do estúdio (com -I), sem '-c' nem script gravado em {trabalho} (nem por outro nome dela)"
        },
        {
          "ferramenta": "Bash",
          "campo": "command",
          "entrada": "^(?!(?:/[\\w.@+-]+)*/tune-up-studio(?:/[\\w.@+-]+)?/node/node_modules/\\.bin/hyperframes )[\\s\\S]*(?i:\\.hyperframes)",
          "motivo": "Bash do estúdio: só o hyperframes fixado cita .hyperframes (o QA confia nos relatórios dessa pasta)"
        }
      ],
      "permitir": [
        "Edit({trabalho}/**)"
      ],
      "prompt": "Pasta de trabalho: {trabalho}. {pedido}",
      "params": [
        {
          "nome": "pedido",
          "rotulo": "Pedido",
          "tipo": "texto",
          "obrigatorio": true,
          "max": 2000
        }
      ]
    }
  ]
}
