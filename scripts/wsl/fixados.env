# signed in SHA256SUMS.gpg by 843938DF228D22F7B3742BC0D94AA3F0EFE21092 (Ubuntu CD Image Automatic Signing Key 2012).
# Re-verify: gpg --verify SHA256SUMS.gpg SHA256SUMS, then grep the file name.
