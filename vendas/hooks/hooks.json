{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/inicio.py\" 2>/dev/null || python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/inicio.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
